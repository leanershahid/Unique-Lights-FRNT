# Base URL of the Unique Lights API. Leave as /api in development (Vite proxies it to the backend).
# In production set the full URL, e.g. https://api.uniquelights.in/api
VITE_API_BASE_URL=/api

# Development only: where the Vite dev server proxies /api requests.
VITE_DEV_API_PROXY=http://localhost:5273

# Currency shown in the storefront (ISO 4217) and the locale used to format it.
VITE_CURRENCY=INR
VITE_LOCALE=en-IN
