# Used by `npm run build`. Not secret.
# The site calls /api on its own domain; vercel.json forwards those requests to the API on Render
# (https://unique-lights-bknd-2.onrender.com). Same-origin requests need no CORS and keep the
# sign-in cookie first-party, which Safari requires.
# Hosting somewhere without that rewrite? Use the full API URL instead:
#   VITE_API_BASE_URL=https://unique-lights-bknd-2.onrender.com/api
VITE_API_BASE_URL=/api

VITE_CURRENCY=INR
VITE_LOCALE=en-IN
